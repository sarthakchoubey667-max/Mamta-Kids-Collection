# Copy this file to .env for local setup. Never commit real secrets.
PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=
OWNER_LOGIN_ID=owner
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# For production, point both paths at persistent storage and set the public HTTPS origin.
# APP_ORIGIN=https://your-store.example
# DATABASE_FILE=/persistent/fashion-store/store.sqlite
# UPLOAD_DIR=/persistent/fashion-store/uploads
# If hosted behind a reverse proxy, set TRUST_PROXY=1 only when the proxy overwrites X-Forwarded-For.
# TRUST_PROXY=1
